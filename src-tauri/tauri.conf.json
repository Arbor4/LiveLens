{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveLens",
  "version": "1.0.1",
  "identifier": "com.livelens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "LiveLens · 幕译",
        "width": 520,
        "height": 400,
        "resizable": true,
        "center": true,
        "minWidth": 520,
        "minHeight": 400,
        "decorations": true,
        "shadow": true,
        "backgroundColor": "#F3F4F6",
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "targets": "all"
  },
  "plugins": {
    "global-shortcut": null,
    "autostart": null
  }
}
